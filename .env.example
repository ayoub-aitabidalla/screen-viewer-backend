PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=screenviewer
DB_USER=screenviewer
DB_PASSWORD=screenviewer
# true pour une base hebergee (Neon, Supabase...)
DB_SSL=false
# 32 caracteres minimum ; chiffre les mots de passe DVR. Ne jamais la changer ensuite.
SECRETS_KEY=
# proxy devant le backend : loopback (Vite), uniquelocal (Docker/Cloudways)
TRUST_PROXY=loopback
# Generer une valeur longue et aleatoire en production.
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
# true si le viewer est servi en HTTPS
COOKIE_SECURE=false
# Utilisateur cree par `npm run seed`
SEED_USERNAME=admin
SEED_PASSWORD=admin123

# DVR Hikvision (ISAPI) - compte limite sans droit de suppression/formatage
DVR_HOST=192.168.8.64
DVR_USER=screenbackend
DVR_PASSWORD=
# go2rtc : API locale + adresse ONVIF vue par le DVR
GO2RTC_URL=http://127.0.0.1:1984
GO2RTC_ONVIF_HOST=192.168.8.246
GO2RTC_ONVIF_PORT=1984
GO2RTC_ONVIF_USER=admin
# 8 a 16 caracteres (exigence du DVR) - doit correspondre a onvif.password dans go2rtc.yaml
GO2RTC_ONVIF_PASSWORD=change-me-8chars
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554
MEDIAMTX_API_URL=http://127.0.0.1:9997
